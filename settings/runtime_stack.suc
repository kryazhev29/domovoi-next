// IAR EWARM 9.50 callbacks; graph cut below is NOT a certified stack bound.
// Retain CSTACK=4096 and the bottom canary until the cut is evaluated manually.
// Modules/comm_* + User/{c,asm}/user_comm_runtime and user_fun_runtime.
possible calls bal_finish [comm_balance.o]: user_comm_balance;
possible calls comm_balance_poll: user_comm_ussd;
possible calls call_volte [comm_call.o]: user_comm_volte;
possible calls comm_call_poll: user_comm_call [user_comm_runtime.o];
possible calls channel_at_event [comm_channel.o]: info_line [comm_info.o];
possible calls channel_binary [comm_channel.o]: user_comm_rx;
possible calls channel_command [comm_channel.o]: comm_text [user_fun_runtime.o], comm_number [user_fun_runtime.o];
possible calls channel_emit [comm_channel.o]: server_channel_event [comm_server.o];
possible calls channel_read_done [comm_channel.o]: user_comm_rx_done;
possible calls comm_at_poll: channel_binary [comm_channel.o];
possible calls event [comm_at.o]: slm_event [comm_modem.o];
possible calls comm_info_poll: user_comm_low_signal;
possible calls comm_modem_build: comm_number [user_fun_runtime.o];
possible calls comm_modem_reserve: comm_number [user_fun_runtime.o];
possible calls comm_power_v5_off: comm_gpio [user_fun_runtime.o];
possible calls comm_power_v5_poll: comm_gpio [user_fun_runtime.o];
possible calls comm_recover_poll: user_comm_reset_session [user_comm_runtime.o];
possible calls rc_night [comm_recover.o]: user_comm_local_time, user_comm_busy;
possible calls server_link [comm_server.o]: user_comm_link;
possible calls server_channel_event [comm_server.o]: user_comm_session, comm_recover_no_internet;
possible calls comm_server_poll: user_comm_registration [user_comm_runtime.o], user_comm_status [user_comm_runtime.o], server_rx_process, user_comm_no_traffic [user_comm_runtime.o];
possible calls comm_sms_poll: user_smsreceived;
possible calls slm_completed [comm_modem.o]: comm_type [user_fun_runtime.o];
possible calls slm_event [comm_modem.o]: call_urc [comm_call.o], sms_urc [comm_sms.o], bal_answer [comm_balance.o], volte_line [comm_call.o], sms_line [comm_sms.o], bal_line [comm_balance.o], channel_at_event [comm_channel.o], comm_imei [user_fun_runtime.o], comm_number [user_fun_runtime.o];
possible calls slm_text [comm_modem.o]: comm_text [user_fun_runtime.o];
possible calls ?slm_values [comm_modem.o]: comm_number [user_fun_runtime.o];
possible calls slm_valid_settings [comm_modem.o]: comm_number [user_fun_runtime.o], comm_text [user_fun_runtime.o];

// PROBE_DONE can reopen the channel, emitting one nested CLOSED event. CLOSED
// resets session state and does not reopen the channel (comm_server.c:27-46).
max recursion depth server_channel_event [comm_server.o]: 2;

// sector journal readers: mem_replace_pages / sj_replace / sj_runtime_begin.
possible calls sj_pages_equal [sector_journal_runtime.o]: sj_ram_page [sector_journal_runtime.o], mem_image_page [memory_runtime.o];
possible calls sj_replace_pages: sj_ram_page [sector_journal_runtime.o], mem_image_page [memory_runtime.o];
possible calls sj_runtime_poll: table_chunk [user_fun_runtime.o], expiry_chunk [expiry_runtime.o];

// USB Device_Property, User_Standard_Requests, CopyData, endpoint arrays.
// USB-FS-CDC_User/{Src/usb_prop.c,Src/usb_istr.c,Inc/usb_prop.h,Inc/usb_conf.h}.
possible calls CTR_LP: EP1_IN_Callback, EP3_OUT_Callback, NOP_Process;
possible calls DataStageIn [usb_core.o]: Virtual_Com_Port_GetDeviceDescriptor, Virtual_Com_Port_GetConfigDescriptor, Virtual_Com_Port_GetStringDescriptor, Virtual_Com_Port_GetLineCoding, Virtual_Com_Port_SetLineCoding;
possible calls DataStageOut [usb_core.o]: Virtual_Com_Port_GetDeviceDescriptor, Virtual_Com_Port_GetConfigDescriptor, Virtual_Com_Port_GetStringDescriptor, Virtual_Com_Port_GetLineCoding, Virtual_Com_Port_SetLineCoding;
possible calls Data_Setup0 [usb_core.o]: Virtual_Com_Port_GetDeviceDescriptor, Virtual_Com_Port_GetConfigDescriptor, Virtual_Com_Port_GetStringDescriptor, Virtual_Com_Port_GetLineCoding, Virtual_Com_Port_SetLineCoding, Virtual_Com_Port_Data_Setup, Virtual_Com_Port_Get_Interface_Setting;
possible calls In0_Process: Virtual_Com_Port_SetDeviceAddress, Virtual_Com_Port_Status_In;
possible calls NoData_Setup0 [usb_core.o]: Virtual_Com_Port_NoData_Setup;
possible calls Out0_Process: Virtual_Com_Port_Status_Out;
possible calls Standard_ClearFeature: NOP_Process;
possible calls Standard_GetConfiguration: NOP_Process;
possible calls Standard_GetInterface: NOP_Process;
possible calls Standard_GetStatus: NOP_Process;
possible calls Standard_SetConfiguration: Virtual_Com_Port_SetConfiguration;
possible calls Standard_SetDeviceFeature: NOP_Process;
possible calls Standard_SetEndPointFeature: NOP_Process;
possible calls Standard_SetInterface: Virtual_Com_Port_Get_Interface_Setting, NOP_Process;
possible calls USB_Init: Virtual_Com_Port_init;
possible calls USB_Istr: Virtual_Com_Port_Reset;
possible calls Virtual_Com_Port_Data_Setup: Virtual_Com_Port_GetLineCoding, Virtual_Com_Port_SetLineCoding;

// Three callback rules reproduce IAR AccessViolation (Tests/probe_stack.py).
// The excluded event can issue one nested CLOSED event. The executable code is
// unchanged; Ls014 and this cut prevent using the resulting size to shrink RAM.
exclude server_channel_event [comm_server.o];
